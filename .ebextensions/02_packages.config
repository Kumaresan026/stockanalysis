packages:
  yum:
    python3-devel: []
    gcc: []

commands:
  01_upgrade_pip:
    command: "/usr/bin/python3 -m pip install --upgrade pip"
    ignoreErrors: true

container_commands:
  01_install_library:
    command: "source /var/app/venv/*/bin/activate && pip install -e ."

  02_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true

  03_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput --clear"
    leader_only: true

  04_create_admin:
    # Creates superuser from DJANGO_ADMIN_USERNAME / EMAIL / PASSWORD env vars.
    # Idempotent — safe to run on every deploy. Set credentials in EB Console
    # so the admin always gets the SAME username across restarts,
    # which makes DynamoDB alert recovery by username reliable.
    command: "source /var/app/venv/*/bin/activate && python manage.py create_admin"
    leader_only: true
    ignoreErrors: true

  05_init_aws_resources:
    command: "source /var/app/venv/*/bin/activate && python manage.py init_aws_resources"
    leader_only: true
    ignoreErrors: true
