option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: stock_platform.settings
    # NOTE: DJANGO_DEBUG is intentionally set in 03_environment.config (= "False")
    # Do NOT set it here — EB processes configs alphabetically and 03 wins.
    PYTHONPATH: "/var/app/current"

  aws:elasticbeanstalk:container:python:
    WSGIPath: "stock_platform.wsgi:application"
    NumProcesses: 1
    NumThreads: 15

  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles

  aws:autoscaling:launchconfiguration:
    InstanceType: t2.micro   # Free-tier eligible

  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance  # No load balancer — saves cost
