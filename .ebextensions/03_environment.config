option_settings:
  aws:elasticbeanstalk:application:environment:
    # ─── Django ────────────────────────────────────────────────────────────
    DJANGO_SECRET_KEY: "REPLACE_WITH_A_STRONG_SECRET_KEY_IN_EB_CONSOLE"
    DJANGO_DEBUG: "False"
    DJANGO_ALLOWED_HOSTS: ".elasticbeanstalk.com,localhost"

    # ─── AWS Credentials ───────────────────────────────────────────────────
    # TWO MODES — choose one:
    #
    # MODE A: IAM Role (recommended for Elastic Beanstalk)
    #   The LabRole is attached as the EC2 instance profile in EB → Configuration
    #   → Security. Do NOT set these env vars (or leave as placeholder) and
    #   boto3 will automatically use the instance profile. This means:
    #   - No credential expiry issues
    #   - No manual refresh needed
    #   - All AWS calls use LabRole permissions
    #
    # MODE B: Explicit credentials (AWS Academy / local dev)
    #   If you MUST override with explicit keys (e.g. testing specific creds),
    #   set all three below in EB Console → Configuration → Software → Env Props.
    #   AWS Academy credentials expire every ~4-6 hours — refresh before testing.
    #   Leave as 'REPLACE_IN_EB_CONSOLE' to use MODE A (IAM role).
    AWS_ACCESS_KEY_ID: "REPLACE_IN_EB_CONSOLE"
    AWS_SECRET_ACCESS_KEY: "REPLACE_IN_EB_CONSOLE"
    AWS_SESSION_TOKEN: "REPLACE_IN_EB_CONSOLE"
    AWS_DEFAULT_REGION: "us-east-1"

    # ─── DynamoDB Table Names ─────────────────────────────────────────────
    DYNAMODB_STOCKS_TABLE: "stock_data"
    DYNAMODB_WATCHLIST_TABLE: "user_watchlists"
    DYNAMODB_ALERTS_TABLE: "alert_rules"
    DYNAMODB_ANALYTICS_TABLE: "analytics_results"

    # ─── S3 / SQS / SNS / CloudWatch ─────────────────────────────────────
    S3_BUCKET_NAME: "stock-platform-reports-2024"
    SQS_QUEUE_NAME: "stock-events-queue"
    SNS_TOPIC_NAME: "stock-alerts-topic"
    SNS_ALERT_EMAIL: "kumaresan2126@gmail.com"
    # Full ARN bypasses list_topics() on every request — faster & more reliable.
    # Find it: AWS Console → SNS → Topics → stock-alerts-topic → ARN
    SNS_TOPIC_ARN: "arn:aws:sns:us-east-1:669473726067:stock-alerts-topic"
    CLOUDWATCH_LOG_GROUP: "stock-platform-logs"

    # ─── Stock APIs (optional — demo data works without these) ────────────
    ALPHA_VANTAGE_API_KEY: ""
    FINNHUB_API_KEY: ""

    # ─── Lambda Function Names ────────────────────────────────────────────
    LAMBDA_STOCK_PROCESSOR: "stock_processor"
    LAMBDA_ALERT_HANDLER: "alert_handler"

    # ─── Admin Account (auto-created on deploy by create_admin command) ───
    # Set these in EB Console — never hardcode real passwords here.
    # The admin USERNAME must stay the same across deploys for DynamoDB
    # alert recovery by username to work correctly.
    DJANGO_ADMIN_USERNAME: "admin"
    DJANGO_ADMIN_EMAIL: "admin@example.com"
    DJANGO_ADMIN_PASSWORD: "REPLACE_WITH_STRONG_PASSWORD_IN_EB_CONSOLE"

