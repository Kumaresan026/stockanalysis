# ─── IAM Permissions Required for LabRole ──────────────────────────────────
# AWS Academy environments provide a pre-existing IAM role called "LabRole".
# The Elastic Beanstalk EC2 instance profile must have this role attached.
#
# These permissions are already granted by LabRole in AWS Academy.
# This file documents them for reference and academic assessment purposes.
#
# To verify permissions in AWS Console:
#   IAM → Roles → LabRole → Permissions → View attached policies
#
# To verify the EC2 instance profile in EB Console:
#   Elastic Beanstalk → Environment → Configuration → Security
#   → EC2 instance profile: aws-elasticbeanstalk-ec2-role (backed by LabRole)
# ────────────────────────────────────────────────────────────────────────────

# NOTE: In AWS Academy, IAM resources cannot be created via CloudFormation
# or .ebextensions. This file documents the existing LabRole permissions.
# No AWS resources are created by this file.

option_settings:
  aws:elasticbeanstalk:application:environment:
    # Placeholder — IAM role is configured at the environment level in EB Console
    # EC2_INSTANCE_PROFILE: "aws-elasticbeanstalk-ec2-role"
    _IAM_NOTE: "See comments above — LabRole is pre-configured by AWS Academy"

# ─── Required IAM Actions (all granted by AWS Academy LabRole) ───────────
#
# Amazon SNS — Email Notifications
#   sns:CreateTopic         Create the stock-alerts-topic if it doesn't exist
#   sns:ListTopics          Discover existing topic ARN (bypassed if SNS_TOPIC_ARN is set)
#   sns:Publish             Send email alerts to subscribers
#   sns:Subscribe           Subscribe user emails to the topic
#   sns:ListSubscriptionsByTopic   Check subscription status
#
# Amazon SQS — Event Queue
#   sqs:CreateQueue         Create stock-events-queue
#   sqs:GetQueueUrl         Resolve queue URL
#   sqs:GetQueueAttributes  Read queue ARN for Lambda trigger
#   sqs:SendMessage         Django → SQS (STOCK_UPDATE, ALERT_CREATED events)
#   sqs:ReceiveMessage      poll_sqs worker reads messages
#   sqs:DeleteMessage       Acknowledge processed messages
#
# Amazon DynamoDB — Persistent Storage
#   dynamodb:CreateTable    Initialise tables on first deploy
#   dynamodb:DescribeTable  Check table status
#   dynamodb:PutItem        Store stock data, alert rules, watchlists
#   dynamodb:GetItem        Retrieve individual records
#   dynamodb:UpdateItem     Mark alerts as triggered
#   dynamodb:DeleteItem     Delete alert rules
#   dynamodb:Query          Filtered alert lookups by user_id
#   dynamodb:Scan           Scan alert_rules for matching symbols
#
# Amazon S3 — Report Storage
#   s3:CreateBucket         Create stock-platform-reports-2024 bucket
#   s3:PutObject            Upload analytics JSON and CSV reports
#   s3:GetObject            Read stored reports
#   s3:ListBucket           List available reports
#
# AWS Lambda — Serverless Processing
#   lambda:CreateFunction   Deploy stock_processor / alert_handler
#   lambda:UpdateFunctionCode        Update Lambda code on redeploy
#   lambda:UpdateFunctionConfiguration   Update Lambda config
#   lambda:InvokeFunction            Direct invocation fallback
#   lambda:GetFunction               Check if function exists
#   lambda:CreateEventSourceMapping  Connect SQS → Lambda trigger
#   lambda:ListEventSourceMappings   Check existing triggers
#
# Amazon CloudWatch Logs — Structured Logging
#   logs:CreateLogGroup     Create stock-platform-logs group
#   logs:CreateLogStream    Create log streams per Lambda invocation
#   logs:PutLogEvents       Write structured log events
#   logs:DescribeLogGroups  Verify log group exists
#
# AWS STS — Credential Validation
#   sts:GetCallerIdentity   Validate credentials on startup (used by aws_session.py)
#
# AWS IAM — Lambda Role Lookup
#   iam:GetRole             Retrieve LabRole ARN for Lambda deployment
# ─────────────────────────────────────────────────────────────────────────────
