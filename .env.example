# ─── Django Settings ──────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── AWS Credentials ──────────────────────────────────────────────────────────
# !! WARNING: Never commit real credentials to source control !!
# For AWS Academy: copy from AWS Academy → AWS Details → AWS CLI (refresh ~every 4-6h)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_SESSION_TOKEN=your-session-token-if-using-aws-academy
AWS_DEFAULT_REGION=us-east-1

# ─── AWS Resource Names ───────────────────────────────────────────────────────
DYNAMODB_STOCKS_TABLE=stock_data
DYNAMODB_WATCHLIST_TABLE=user_watchlists
DYNAMODB_ALERTS_TABLE=alert_rules
DYNAMODB_ANALYTICS_TABLE=analytics_results
S3_BUCKET_NAME=stock-platform-reports-2024
SQS_QUEUE_NAME=stock-events-queue
SNS_TOPIC_NAME=stock-alerts-topic
CLOUDWATCH_LOG_GROUP=stock-platform-logs

# ─── Stock API Keys (optional — demo data works without these) ────────────────
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key

# ─── Lambda Function Names ────────────────────────────────────────────────────
LAMBDA_STOCK_PROCESSOR=stock_processor
LAMBDA_ALERT_HANDLER=alert_handler
