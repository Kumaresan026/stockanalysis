container_commands:
  # Make all platform hook scripts executable after deployment
  01_chmod_hooks:
    command: |
      find /var/app/staging/.platform/hooks -type f -name "*.sh" \
        -exec chmod +x {} \; 2>/dev/null || true
    ignoreErrors: true

  # Verify AWS connectivity and log the result (non-blocking)
  02_check_aws_on_deploy:
    command: >
      source /var/app/venv/*/bin/activate &&
      python manage.py shell -c "
      from stocks.services.aws_session import check_aws_available;
      ok = check_aws_available();
      print('[DEPLOY CHECK] AWS credentials valid:', ok);
      print('[DEPLOY CHECK] If False, update credentials in EB Console before testing.')
      " || true
    leader_only: true
    ignoreErrors: true
