container_commands:
  # Make all platform hook scripts executable after deployment
  01_chmod_hooks:
    command: |
      find /var/app/staging/.platform/hooks -type f -name "*.sh" \
        -exec chmod +x {} \; 2>/dev/null || true
    ignoreErrors: true

  # Verify IAM role is active (non-blocking — just logs the result)
  02_check_iam_role:
    command: >
      source /var/app/venv/*/bin/activate &&
      python -c "
import boto3, os
try:
    sts = boto3.client('sts', region_name=os.getenv('AWS_DEFAULT_REGION','us-east-1'))
    identity = sts.get_caller_identity()
    print('[DEPLOY CHECK] IAM role:', identity.get('Arn','unknown'))
except Exception as e:
    print('[DEPLOY CHECK] IAM role check failed:', e)
" || true
    leader_only: true
    ignoreErrors: true
