container_commands:
  01_chmod_hooks:
    command: "find /var/app/staging/.platform/hooks -type f -name '*.sh' -exec chmod +x {} \\; 2>/dev/null || true"
    ignoreErrors: true

  02_check_iam_role:
    command: "source /var/app/venv/*/bin/activate && python -c \"import boto3,os; sts=boto3.client('sts',region_name=os.getenv('AWS_DEFAULT_REGION','us-east-1')); print('[DEPLOY] IAM role:', sts.get_caller_identity().get('Arn','unknown'))\" || true"
    leader_only: true
    ignoreErrors: true
